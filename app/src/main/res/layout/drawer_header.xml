<?xml version="1.0" encoding="utf-8"?>
<!-- Included in the drawer panel (activity_main), not a window root: the Overdraw check does not apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ws_brand"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/space_24"
    android:paddingBottom="@dimen/space_24"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/brand_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/ws_on_brand" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/drawer_header_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/ws_on_brand" />
</LinearLayout>
