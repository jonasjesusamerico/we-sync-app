<?xml version="1.0" encoding="utf-8"?>
<!-- Entering Home or Login from outside the auth flow clears the back stack (popUpTo the graph, inclusive),
     so Back from Home closes the app instead of returning to Login. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/sessionGateFragment">

    <!-- Drawer: Lançamentos › Novo lançamento. -->
    <action
        android:id="@+id/action_global_purchaseForm"
        app:destination="@id/purchaseFormFragment"
        app:launchSingleTop="true" />

    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/sessionGateFragment"
        android:name="com.github.jonasjesusamerico.we_sync_app.auth.ui.SessionGateFragment"
        android:label="@string/brand_name"
        tools:layout="@layout/fragment_session_gate">

        <action
            android:id="@+id/action_sessionGate_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_sessionGate_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.github.jonasjesusamerico.we_sync_app.auth.ui.LoginFragment"
        android:label="@string/brand_name"
        tools:layout="@layout/fragment_login">

        <argument
            android:name="email"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="accountCreated"
            android:defaultValue="false"
            app:argType="boolean" />

        <action
            android:id="@+id/action_login_to_signUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.github.jonasjesusamerico.we_sync_app.auth.ui.SignUpFragment"
        android:label="@string/title_sign_up"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signUp_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signUp_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.github.jonasjesusamerico.we_sync_app.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_createMenu"
            app:destination="@id/createMenuSheet" />
    </fragment>

    <!-- "+" menu. Choosing an option replaces the sheet with the option's screen. -->
    <dialog
        android:id="@+id/createMenuSheet"
        android:name="com.github.jonasjesusamerico.we_sync_app.home.CreateMenuBottomSheet"
        tools:layout="@layout/bottom_sheet_create_menu">

        <action
            android:id="@+id/action_createMenu_to_purchaseForm"
            app:destination="@id/purchaseFormFragment"
            app:popUpTo="@id/createMenuSheet"
            app:popUpToInclusive="true" />
    </dialog>

    <fragment
        android:id="@+id/purchaseFormFragment"
        android:name="com.github.jonasjesusamerico.we_sync_app.purchase.ui.PurchaseFormFragment"
        android:label="@string/title_purchase_form"
        tools:layout="@layout/fragment_purchase_form" />
</navigation>
